# --- Runtime / user-specific (never commit) ---
# vault_config.json points at the user's vault root; per-machine.
vault_config.json
# studio_config.json is site-specific (see studio_config.example.json).
studio_config.json

# --- Python build cruft ---
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.pytest_cache/

# --- Build artifacts / archives ---
*.zip

# Tests are versioned in this fork (still excluded from the registry
# package by .comfyignore).

# --- Standalone app build (not part of the published node) ---
standalone_app/

# --- Local ComfyUI test install (portable, multi-GB; for live testing only) ---
ComfyUI_windows_portable/

# --- Editor / assistant workspace ---
.claude/
.vscode/
.idea/
*.code-workspace

# --- OS cruft ---
.DS_Store
Thumbs.db
desktop.ini
